<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hms_privilege" model="res.groups.privilege">
            <field name="name">HMS</field>
            <field name="sequence">100</field>
        </record>

        <record id="group_hms_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="hms_privilege"/>
            <field name="comment">HMS User</field>
        </record>

        <record id="group_hms_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="hms_privilege"/>
            <field name="comment">HMS Manager</field>
        </record>

        <record id="base.user_admin" model="res.users" context="{'no_reset_password': True}">
            <field name="groups_id" eval="[(4, ref('group_hms_manager'))]"/>
        </record>

        <record id="hms_patient_user_rule" model="ir.rule">
            <field name="name">HMS Patient: User access own records only</field>
            <field name="model_id" ref="model_hms_patient"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hms_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
