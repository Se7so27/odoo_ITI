<odoo>
    <menuitem id="hms_menu_department" name="Departments" parent="hms_menu_root"/>

    <record id="action_hms_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">hms.department</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_hms_department_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="act_window_id" ref="action_hms_department"/>
    </record>

    <record id="action_hms_department_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="20"/>
        <field name="view_mode">form</field>
        <field name="act_window_id" ref="action_hms_department"/>
    </record>

    <menuitem id="hms_menu_department_action" name="Manage Departments"
              parent="hms_menu_department" action="action_hms_department"/>

    <record id="view_hms_department_list" model="ir.ui.view">
        <field name="name">hms.department.list</field>
        <field name="model">hms.department</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="capacity"/>
                <field name="is_opened"/>
            </list>
        </field>
    </record>

    <record id="view_hms_department_form" model="ir.ui.view">
        <field name="name">hms.department.form</field>
        <field name="model">hms.department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="capacity"/>
                        <field name="is_opened"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
